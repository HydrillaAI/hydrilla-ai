# ==============================================================================
# Hydrilla AI Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
apps/*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.environment
.env.staging
.env.local.*

# App-level env files
apps/*/.env
apps/*/.env*
apps/*/.env.local
apps/*/.env.*.local

# Allow example env files to be tracked
!.env.example
!apps/*/.env.example
!apps/**/.env.example

# Service accounts, private keys & SSL certificates
*.pem
*.key
*.key.json
gcp-key.json
service-account*.json
credentials.json
client_secret*.json

# ------------------------------------------------------------------------------
# Build Outputs & Bundles
# ------------------------------------------------------------------------------
.next/
apps/*/.next/
out/
apps/*/out/
build/
apps/*/build/
dist/
apps/*/dist/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Generated email templates
apps/frontend/email/dist/

# ------------------------------------------------------------------------------
# Vercel & Deployments
# ------------------------------------------------------------------------------
.vercel/
apps/*/.vercel/

# ------------------------------------------------------------------------------
# Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
apps/*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Temporary Files & Local Uploads
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
uploads/
apps/*/uploads/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Hydrilla App-Specific Local Caches & Large Media
# ------------------------------------------------------------------------------
apps/frontend/.clerk/
apps/frontend/.claude/
apps/docs/.mintlify/

# Heavy 3D assets & media stored in Cloudinary / S3 (not Git)
apps/frontend/public/3d-models/
apps/frontend/public/3dheroimages/
apps/frontend/public/reference/
apps/frontend/public/landing-3d-assets/
apps/frontend/public/why-hydrilla/
apps/frontend/public/pricing/
apps/frontend/public/demo/

# Database dumps and local backups
backups/
*.sql
*.sql.gz
C72EEEC0-*.png

# Python caches (if any local scripting used)
__pycache__/
*.py[cod]

# Personal Claude Code rules
CLAUDE.local.md

# Repo uses npm; ignore stray lockfiles from other package managers
pnpm-lock.yaml
yarn.lock
