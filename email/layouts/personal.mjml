<mjml>
  <mj-head>
    <mj-title>%%SUBJECT%%</mj-title>
    <mj-preview>%%PREHEADER%%</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.65" color="#0a0a0b" padding="0 0 14px" />
    </mj-attributes>
    <mj-style>
      a { color: #002664; }
      .muted, .muted a { color: #5b6472 !important; }
      @media (prefers-color-scheme: dark) {
        /* Stays light in dark mode: the logo is black on transparent. */
        .muted, .muted a { color: #5b6472 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff" css-class="body-bg" width="560px">
    <mj-section padding="32px 24px 8px" css-class="note">
      <mj-column>
        %%BODY%%
        <mj-image src="%%LOGO_URL%%" alt="Hydrilla AI" width="120px" align="left" padding="6px 0 0" href="https://hydrilla.ai" />
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px 32px">
      <mj-column>
        <mj-text css-class="muted" font-size="12px" line-height="1.6" color="#5b6472" padding="0">
          %%FOOTER_REASON%%<br />
          %%LEGAL_LINE%%%%FOOTER_PREFS%%
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
