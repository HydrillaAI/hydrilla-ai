{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/cron/expire-credits",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/gpu-auto-stop",
      "schedule": "* * * * *"
    }
  ]
}
