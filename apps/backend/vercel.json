{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pnpm install --filter hydrilla-backend...",
  "ignoreCommand": "git rev-parse -q --verify \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" >/dev/null 2>&1 && B=$VERCEL_GIT_PREVIOUS_SHA || B=HEAD^; git diff --quiet $B HEAD -- . 2>/dev/null || exit 1",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/cron/expire-credits",
      "schedule": "5 0 * * *"
    }
  ]
}
