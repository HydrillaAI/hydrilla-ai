{
  "name": "hydrilla-mcp",
  "version": "2.0.1",
  "description": "MCP server for Hydrilla: generate 3D models and send them into Blender, Unity, Unreal, Godot, Maya or 3ds Max.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hydrilla",
    "3d",
    "text-to-3d",
    "image-to-3d",
    "blender",
    "unity",
    "unreal",
    "godot"
  ],
  "homepage": "https://hydrilla.ai/integrations/mcp",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "hydrilla-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@posthog/mcp": "^1.0.0",
    "posthog-node": "^5.63.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
