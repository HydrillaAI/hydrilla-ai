<mjml>
  <mj-head>
    <mj-title>%%SUBJECT%%</mj-title>
    <mj-preview>%%PREHEADER%%</mj-preview>
    <mj-attributes>
      <mj-all font-family="'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#0a0a0b" padding="0 0 14px" />
      <mj-button align="left" padding="6px 0 18px" background-color="#002664" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" inner-padding="12px 22px" />
      <mj-image padding="0 0 16px" />
    </mj-attributes>
    <mj-style>
      a { color: #002664; }
      .muted, .muted a { color: #5b6472 !important; }
      @media (prefers-color-scheme: dark) {
        .body-bg { background-color: #0a0a0a !important; }
        .card { background-color: #111214 !important; }
        .card p, .card h1, .card li, .card div { color: #f4f6fa !important; }
        .card a { color: #7eb1e3 !important; }
        .muted, .muted a { color: #9aa3b2 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5fb" css-class="body-bg" width="600px">
    <mj-section padding="28px 0 0"><mj-column><mj-spacer height="0px" /></mj-column></mj-section>

    <!-- Logo is black on transparent: the header stays white in dark mode so it stays visible. -->
    <mj-section background-color="#ffffff" border-radius="12px 12px 0 0" padding="26px 28px 4px">
      <mj-column>
        <mj-image src="%%LOGO_URL%%" alt="Hydrilla AI" width="148px" align="left" padding="0" href="https://hydrilla.ai" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" css-class="card" border-radius="0 0 12px 12px" padding="18px 28px 32px">
      <mj-column>
        <mj-text padding="0 0 12px">
          <h1 style="margin:0;font-size:24px;line-height:1.25;font-weight:700;">%%HEADING%%</h1>
        </mj-text>
        %%BODY%%
      </mj-column>
    </mj-section>

    <mj-section padding="20px 24px 36px">
      <mj-column>
        <mj-text css-class="muted" font-size="12px" line-height="1.6" color="#5b6472" padding="0">
          %%FOOTER_REASON%%<br />
          %%LEGAL_LINE%%<br />
          Questions? Write to <a href="mailto:hi@hydrilla.ai">hi@hydrilla.ai</a>.%%FOOTER_PREFS%%
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
