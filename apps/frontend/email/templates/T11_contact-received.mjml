<!--
id: T11
name: Contact message received
layout: base
kind: transactional
sender: hi
category: account
topic: none
trigger: contact_submitted
phase: 1
subject: We've got your message
preheader: A person at Hydrilla will reply to you.
footer_reason: You're receiving this because you sent a message through the Hydrilla contact form.
optional: false
facts: do not promise a reply time until the team agrees one
data: name, message
-->
<mj-text>Hi {{ trigger.name | default: "there" }},</mj-text>
<mj-text>Thanks for writing to us. A person at Hydrilla will reply from <a href="mailto:hi@hydrilla.ai">hi@hydrilla.ai</a>.</mj-text>
<mj-raw>{% if trigger.message %}</mj-raw>
<mj-text css-class="muted" font-size="14px">Your message: "{{ trigger.message | default: "" | truncate: 300 | replace: "<", "&lt;" | replace: ">", "&gt;" }}"</mj-text>
<mj-raw>{% endif %}</mj-raw>
